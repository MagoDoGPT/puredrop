# Copy to .env.local and fill in once the backend exists.
# Vite only exposes vars prefixed with VITE_ to the client bundle.

# Base URL of the PureDrop API (no trailing slash).
VITE_API_URL=

# Stripe publishable key — used to bootstrap Stripe.js for checkout.
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional: separate base for static product imagery / CDN.
VITE_ASSETS_URL=
